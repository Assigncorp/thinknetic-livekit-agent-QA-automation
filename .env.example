# ---- copy to .env and fill in; .env is gitignored ----
#
# ONLY the target and secrets live here. Everything else about the test bed -
# knowledge bases, serial routing, scenario selection, budgets, assertion
# strictness - is in config/testbed.config.json.

# Target environment under test
BASE_URL=https://etnyre-dev.thinknetic.app
PRODUCT_SLUG=chip-spreader
ORG_SLUG=e

# Playwright
HEADLESS=false
SLOW_MO=0
UI_TIMEOUT_MS=30000

# App login (phase 2 - only needed for authenticated flows)
APP_USER=
APP_PASSWORD=

# LiveKit (phase 3 - voice suite)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
