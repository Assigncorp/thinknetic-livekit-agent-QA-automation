# ---- copy to .env and fill in; .env is gitignored ----

# LiveKit project the deployed agent runs on.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The name the agent worker registers with; the test dispatches it by this name.
# AGENT_NAME=thinknetic-agents-nonprod

# The KB-steps call. Each run picks one model at random from kb/smoke_serials.yaml
# and one question for that model from kb/question_bank.yaml; the seed is logged.
# KB_SEED=123456789          # reproduce a run's model and question
# KB_MODEL=FHRC28            # pin the model (VHRS28, FHRC28, VHRS36, FHRC36)
# KB_QUESTION_ID=...         # pin one question bank entry
# KB_RETRIES=1               # a failed live call is retried once in a fresh room

# Pass mark for the spoken answer and the texted steps: the share of KB steps and
# cautions that must match. A wrong value (30 seconds said as 60) always fails.
# KB_PASS_THRESHOLD=0.95
# 1 = also fail when the SMS provider refuses the text (the default test number is a landline).
# TEXT_REQUIRE_DELIVERY=0
# The agent's LiveKit Cloud ID for reading its logs; looked up from AGENT_NAME when unset.
# AGENT_ID=

# The test caller. The serial comes from kb/smoke_serials.yaml. Defaults shown.
# TEST_CALLER_NAME=Dale Hutchins
# TEST_CALLER_COMPANY=Fielder Paving
# TEST_CALLER_PHONE=4805550142

# The product the agent supports - sent to it as dispatch metadata. Defaults shown.
# PRODUCT_NAME=Chip Spreader
# PRODUCT_BRAND=Etnyre
# ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
# ORG_SLUG=e
# KNOWLEDGE_BASE_ID=34456cd9-49ea-4d87-8edb-9a60b02e0321
# ASSISTANT=enterprises-product-support-assistant
