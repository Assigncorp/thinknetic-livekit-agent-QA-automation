# ---- copy to .env and fill in; .env is gitignored ----
#
# This suite is product-agnostic. Pointing it at a different product is an
# edit to this file plus its own config under config/, never a code change.
#
#   1. copy config/testbed.config.json to config/<product>.config.json
#   2. describe that product's knowledge bases, serials and conversation in it
#   3. set TESTBED_CONFIG + BASE_URL + ORG_SLUG + PRODUCT_SLUG below
#   4. make resources && make chat

# ---------------------------------------------------------------- the target
BASE_URL=https://etnyre-dev.thinknetic.app
ORG_SLUG=e
PRODUCT_SLUG=chip-spreader

# What the product page's <title> should contain. Defaults to PRODUCT_SLUG with
# its hyphens turned into spaces, which is right whenever the title is just the
# product name.
# PRODUCT_TITLE=Chip Spreader

# ------------------------------------------------- which product to describe
# Knowledge bases, serial routing, the conversation contract, budgets and
# assertion strictness all live in this file. One per product.
TESTBED_CONFIG=config/testbed.config.json

# ------------------------------------------------------------------ the run
HEADLESS=false
SLOW_MO=0
UI_TIMEOUT_MS=30000

# ---------------------------------------------- overrides (optional, no edit)
# Everything below already has a value in TESTBED_CONFIG. Set one here only to
# override it for a run - handy for a slower environment or a stricter gate,
# without touching the committed config.

# Latency budgets, milliseconds. These measure time to a COMPLETE agent turn,
# not time to its first word.
# BUDGET_SESSION_CONNECT_MS=20000
# BUDGET_GREETING_MS=45000
# BUDGET_MACHINE_MS=60000
# BUDGET_ANSWER_MS=45000
# BUDGET_WRAP_UP_MS=45000
# BUDGET_API_MS=3000

# How the conversation is driven.
#   TURN_QUIET_MS      - how long an agent turn must stop changing before it
#                        counts as finished. The agent is voice-paced and pauses
#                        mid-sentence; too low and assertions judge a fragment.
#   MAX_CLARIFICATIONS - how many of the agent's own follow-up questions to
#                        answer before giving up on reaching a real answer.
#   MAX_TURNS          - upper bound on agent turns in one call. The agent walks
#                        procedures one step at a time, so a full answer needs
#                        room; bounded so a call that never lands still fails.
#   MUTE_MIC_ON_START  - a session opens with the microphone LIVE, so the agent
#                        can hear the room. Every session mutes and verifies it
#                        before typing. Only turn off for a product whose
#                        session panel has no mic control.
#   CLOSING_STATEMENT  - what the caller says to close the call once the answer
#                        is in. A rating is only asked for at a call's natural
#                        end, and a caller who simply stops typing never gets
#                        there. Keep it a sign-off: never put a score in it, or
#                        the run goes green on a defect that is still there.
# MUTE_MIC_ON_START=true
# TURN_QUIET_MS=4000
# MAX_TURNS=16
# MAX_CLARIFICATIONS=4
# CLOSING_STATEMENT="That answers it, thank you - I'm all set and that's everything I needed today."

# How strictly an answer is judged.
#   CHECK_EXPECTED_ANCHORS - the answer must cite a hard fact from the KB entry
#   FAIL_ON_WRONG_CONTROLLER_FAMILY - an RC-36 serial must not get an RC-28 answer
#   REQUIRE_CLOSING_STATEMENT - after the caller gives a rating, the agent must
#                        actually close the call rather than going quiet and
#                        leaving the caller to hang up on a dangling question.
# REQUIRE_CLOSING_STATEMENT=true
# CHECK_EXPECTED_ANCHORS=true
# FAIL_ON_WRONG_CONTROLLER_FAMILY=false
# MIN_REPLY_CHARS=20

# Which scenario a run picks. Set SCENARIO_SEED to reproduce a failing run
# exactly, or SCENARIO_ID to pin one specific question.
# SCENARIO_SEED=12345
# SCENARIO_ID=FHRC28-HOW-019
# ROTATE_SERIALS=true

# Slugs used by the fail-closed checks; they must NOT exist.
# UNKNOWN_ORG_SLUG=zz-not-an-org
# UNKNOWN_PRODUCT_SLUG=definitely-not-a-real-product

# --------------------------------------------- rate limiting and performance
# The API allows 100 requests a minute across the WHOLE suite, and charges for
# 404s as well as 200s. The API suite watches the x-ratelimit-* headers and
# parks itself when a measurement would dig into the reserve below, rather than
# leaving the tests behind it to fail on a 429. See docs/api-test-strategy.md.
#
#   RATE_LIMIT_RESERVE_FLOOR - requests the suite refuses to spend. The browser
#                        suite, CI and anyone clicking through dev share this
#                        window from the same egress IP, so the floor is what
#                        stops a percentile sample causing somebody else a 429.
#                        Raise it when running alongside another suite.
# RATE_LIMIT_RESERVE_FLOOR=15
#
#   RUN_RATE_LIMIT_SATURATION - runs RL-08..RL-10, which DELIBERATELY empty the
#                        window and block every other caller on this IP for up
#                        to a minute. Off in config and off here; `make
#                        saturate` sets it. Never in a PR check.
# RUN_RATE_LIMIT_SATURATION=false

# ------------------------------------------------- semantic scoring (judge/)
# The judge scores the agent's answers AGAINST THE KNOWLEDGE BASE TEXT rather
# than against a model's own world knowledge - which is the whole reason the
# scores mean anything. Rubrics, thresholds and the judge model live in the
# `judge` block of TESTBED_CONFIG, not here.
#
# Reports, does not gate. judge.requireScoreGate is off deliberately: an LLM
# judge disagrees with itself at the margin, and per docs/architecture.md a
# borderline score must never block a release on its own. Scores land in
# reports/judge-scores.json every run; that file is what the thresholds get
# re-based from once there is a fortnight of them.
#
# `make judge-offline` needs none of this - it validates the rubrics and the KB
# grounding with no network and no account, and it is the one that gates a PR.
# ANTHROPIC_API_KEY=sk-ant-...
#
# An `ant auth login` profile works instead of a key and is picked up
# automatically; the suite skips with a reason when it finds neither.

# ------------------------------------------------------------------ secrets
# App login (phase 2 - only needed for authenticated flows)
APP_USER=
APP_PASSWORD=

# LiveKit - the SDK suite (sdk/) holds calls through the product's public
# session endpoint and needs NONE of these for that. They are used only to
# OBSERVE rooms (who joined, when the room closed), by `make livekit-auth`, by
# the browser-LiveKit spec, and by `make probe-agent`. Tests that need them skip
# with a reason when they are empty.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Free LLM for the adaptive interview (make livekit-interview): writes the caller's
# follow-up questions from the KB and judges the agent's answers. Create ONE key,
# free, and paste it here. The KB passages and transcripts are sent to that provider.
#   Groq   (default): https://console.groq.com/keys
#   Gemini          : https://aistudio.google.com/apikey   (then LLM_PROVIDER=gemini)
GROQ_API_KEY=
GEMINI_API_KEY=
# Fallback when the free Groq daily quota runs out (BILLED): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=
# INTERVIEW_TURNS=3
# INTERVIEW_CALLS=1

