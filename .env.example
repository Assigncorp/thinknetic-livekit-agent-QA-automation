# ---- copy to .env and fill in; .env is gitignored ----
#
# Two environments: nonprod (the default) and prod. QA_ENV picks the one a run uses, e.g.
# QA_ENV=prod make smoke; in CI it is the environment list under Actions > qa > Run workflow.
# Nonprod's settings have no prefix; prod's start with PROD_.
#
# This file is for laptops only. CI never reads a .env: it reads each setting from the repository
# secret or variable of the SAME name (Settings > Secrets and variables > Actions; see README, CI).
# Changing a value: change its line here, and its secret or variable for CI. No commit.
# Nonprod's agent and product lines are also built in (tests/sdk/lkqa/env.py), so nonprod needs
# only LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET and SMS_TEST_PHONE. Prod needs every line.
#
# In each environment:
#   LIVEKIT_URL         the LiveKit project the deployed agent runs on (wss://<project>.livekit.cloud)
#   LIVEKIT_API_KEY     that project's keys
#   LIVEKIT_API_SECRET
#   AGENT_NAME          the name the agent worker registers with; the test dispatches it by this name
#   AGENT_ID            the agent's LiveKit Cloud ID for reading its logs; looked up from AGENT_NAME when blank
#   SMS_TEST_PHONE      the number that receives the test text. Must differ from TEST_CALLER_PHONE: the
#                       caller asks for the steps to be texted to this other number. A real number gets a
#                       real text from that environment's agent on every run; it is masked in the report.
#   PRODUCT_NAME ... ASSISTANT
#                       the product the agent supports, sent to it as dispatch metadata

# ============================================================================ NONPROD
# The nonprod agent. No prefix.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=thinknetic-agents-nonprod
AGENT_ID=
SMS_TEST_PHONE=
PRODUCT_NAME=Chip Spreader
PRODUCT_BRAND=Etnyre
ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
ORG_SLUG=e
KNOWLEDGE_BASE_ID=34456cd9-49ea-4d87-8edb-9a60b02e0321
ASSISTANT=enterprises-product-support-assistant

# ============================================================================ PROD
# Production.
# A live call here texts a real number and creates a real callback task and call log in prod.
PROD_LIVEKIT_URL=
PROD_LIVEKIT_API_KEY=
PROD_LIVEKIT_API_SECRET=
PROD_AGENT_NAME=
PROD_AGENT_ID=
PROD_SMS_TEST_PHONE=
PROD_PRODUCT_NAME=Chip Spreader
PROD_PRODUCT_BRAND=Etnyre
PROD_ORGANIZATION_ID=
PROD_ORG_SLUG=
PROD_KNOWLEDGE_BASE_ID=
PROD_ASSISTANT=

# ============================================================ both environments (optional)
# The KB-steps call. Each run picks FHRC28 or FHRC36 at random and calls with that model's
# serial from kb/smoke.yaml. That file also holds the one question every call asks, the
# keywords its answer must contain and the one image every call asks to see; edit it to change
# any of them. The seed is logged.
# KB_SEED=123456789          # reproduce a run's model
# KB_MODEL=FHRC28            # pin the model (VHRS28, FHRC28, VHRS36, FHRC36), and so its serial
# KB_RETRIES=1               # a failed live call is retried once in a fresh room

# The test caller. The serial comes from kb/smoke.yaml. Defaults shown.
# TEST_CALLER_NAME=Dale Hutchins
# TEST_CALLER_COMPANY=Fielder Paving
# TEST_CALLER_PHONE=4805550142
