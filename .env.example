# ---- copy to .env and fill in; .env is gitignored ----
#
# One file for every environment, a section each. QA_ENV picks the section a run uses
# (default sit), e.g. QA_ENV=uat make smoke; in CI it is the Environment list under
# Actions > qa > Run workflow. Every setting in a section starts with the environment's
# name: SIT_LIVEKIT_URL is the LIVEKIT_URL of a run with QA_ENV=sit.
#
# CI reads this same file: its whole contents are the ENV_FILE repository secret.
# Changing a URL: change its line here, and in ENV_FILE for CI. No code change, no commit.
# Adding an environment: copy a section with the new name as the prefix, and add the
# name to the environment list in .github/workflows/smoke.yml.
#
# In each section:
#   LIVEKIT_URL         the LiveKit project the deployed agent runs on (wss://<project>.livekit.cloud)
#   LIVEKIT_API_KEY     that project's keys
#   LIVEKIT_API_SECRET
#   AGENT_NAME          the name the agent worker registers with; the test dispatches it by this name
#   AGENT_ID            the agent's LiveKit Cloud ID for reading its logs; looked up from AGENT_NAME when blank
#   SMS_TEST_PHONE      the number that receives the test text. Must differ from TEST_CALLER_PHONE: the
#                       caller asks for the steps to be texted to this other number. A real number gets a
#                       real text from that environment's agent on every run; it is masked in the report.
#   PRODUCT_NAME ... ASSISTANT
#                       the product the agent supports, sent to it as dispatch metadata

# ============================================================================ SIT
# SIT - the nonprod agent.
SIT_LIVEKIT_URL=
SIT_LIVEKIT_API_KEY=
SIT_LIVEKIT_API_SECRET=
SIT_AGENT_NAME=thinknetic-agents-nonprod
SIT_AGENT_ID=
SIT_SMS_TEST_PHONE=
SIT_PRODUCT_NAME=Chip Spreader
SIT_PRODUCT_BRAND=Etnyre
SIT_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
SIT_ORG_SLUG=e
SIT_KNOWLEDGE_BASE_ID=34456cd9-49ea-4d87-8edb-9a60b02e0321
SIT_ASSISTANT=enterprises-product-support-assistant

# ============================================================================ UAT
# UAT.
UAT_LIVEKIT_URL=
UAT_LIVEKIT_API_KEY=
UAT_LIVEKIT_API_SECRET=
UAT_AGENT_NAME=
UAT_AGENT_ID=
UAT_SMS_TEST_PHONE=
UAT_PRODUCT_NAME=Chip Spreader
UAT_PRODUCT_BRAND=Etnyre
UAT_ORGANIZATION_ID=
UAT_ORG_SLUG=
UAT_KNOWLEDGE_BASE_ID=
UAT_ASSISTANT=

# ============================================================================ PROD
# Production.
# A live call here texts a real number and creates a real callback task and call log in prod.
PROD_LIVEKIT_URL=
PROD_LIVEKIT_API_KEY=
PROD_LIVEKIT_API_SECRET=
PROD_AGENT_NAME=
PROD_AGENT_ID=
PROD_SMS_TEST_PHONE=
PROD_PRODUCT_NAME=Chip Spreader
PROD_PRODUCT_BRAND=Etnyre
PROD_ORGANIZATION_ID=
PROD_ORG_SLUG=
PROD_KNOWLEDGE_BASE_ID=
PROD_ASSISTANT=

# ============================================================ every environment (optional)
# The KB-steps call. Each run picks one model at random from kb/smoke_serials.yaml
# and one question for that model from kb/question_bank.yaml; the seed is logged.
# KB_SEED=123456789          # reproduce a run's model and question
# KB_MODEL=FHRC28            # pin the model (VHRS28, FHRC28, VHRS36, FHRC36)
# KB_QUESTION_ID=...         # pin one question bank entry
# KB_RETRIES=1               # a failed live call is retried once in a fresh room

# Pass mark for the spoken answer and the texted steps: the share of KB steps and
# cautions that must match. A wrong value (30 seconds said as 60) always fails.
# KB_PASS_THRESHOLD=0.95

# The test caller. The serial comes from kb/smoke_serials.yaml. Defaults shown.
# TEST_CALLER_NAME=Dale Hutchins
# TEST_CALLER_COMPANY=Fielder Paving
# TEST_CALLER_PHONE=4805550142
